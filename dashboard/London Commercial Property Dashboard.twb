      </column>
      <column caption='Show Chart 3' datatype='boolean' name='[Calculation_1031409310941186]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Sector number&quot;' />
      </column>
      <column caption='Show Chart 4' datatype='boolean' name='[Calculation_1031409311002627]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Price and distance of each store&quot;' />
      </column>
      <column caption='Total Listings' datatype='string' name='[Calculation_1031409510813700]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Total Listings&quot; + CHAR(10) + STR(COUNTD([links]))' />
      </column>
      <column caption='Average Price' datatype='string' name='[Calculation_1031409512534021]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Average Price&quot; + CHAR(10) + &quot;£&quot; + STR(ROUND(AVG([Calculation_2591890495082499]), 0))' />
      </column>
      <column caption='Average Distance' datatype='string' name='[Calculation_1031409512632326]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Average Distance&quot; + CHAR(10) + STR(ROUND(AVG([gap_station (miles from bank station)]), 2)) + &quot; miles&quot;' />
      </column>
      <column caption='Show Info Detail Information' datatype='boolean' name='[Calculation_1031409523589127]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Detail Information&quot;' />
      </column>
      <column caption='Show Info Link' datatype='boolean' name='[Calculation_1031409523695624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Link&quot;' />
      </column>
      <column caption='Show Info Distance Band' datatype='boolean' name='[Calculation_1031409523785737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Distance Band&quot;' />
      </column>
      <column caption='Show Info Price Band' datatype='boolean' name='[Calculation_1031409523867658]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Price Band&quot;' />
      </column>
      <column caption='Price Band' datatype='string' name='[Calculation_1031409524092939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_2591890495082499]) THEN&#13;&#10;    &quot;Unknown&quot;&#13;&#10;ELSEIF [Calculation_2591890495082499] &lt; 200000 THEN&#13;&#10;    &quot;Under £200k&quot;&#13;&#10;ELSEIF [Calculation_2591890495082499] &lt;= 500000 THEN&#13;&#10;    &quot;£200k - £500k&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Over £500k&quot;&#13;&#10;END' />
      </column>
      <column caption='Distance Band' datatype='string' name='[Calculation_1031409524195340]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([gap_station (miles from bank station)]) THEN&#13;&#10;    &quot;Unknown&quot;&#13;&#10;ELSEIF [gap_station (miles from bank station)] &lt; 3 THEN&#13;&#10;    &quot;Near (&lt;3 miles)&quot;&#13;&#10;ELSEIF [gap_station (miles from bank station)] &lt;= 8 THEN&#13;&#10;    &quot;Medium (3-8 miles)&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Far (&gt;8 miles)&quot;&#13;&#10;END' />
      </column>
      <column caption='Link Text' datatype='string' name='[Calculation_1031409524334605]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Link: &quot; + IFNULL(ATTR([links]), &quot;N/A&quot;)' />
      </column>
      <column caption='Distance Band Panel' datatype='string' name='[Calculation_1031409525436430]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Distance Band: &quot; + IFNULL(ATTR([Calculation_1031409524195340]), &quot;N/A&quot;)&#13;&#10;+ CHAR(10) + CHAR(10) +&#13;&#10;&quot;Distance to Bank Station: &quot; +&#13;&#10;IF ISNULL(MIN([gap_station (miles from bank station)])) THEN&#13;&#10;    &quot;N/A&quot;&#13;&#10;ELSE&#13;&#10;    STR(ROUND(MIN([gap_station (miles from bank station)]), 2)) + &quot; miles&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Band Panel' datatype='string' name='[Calculation_1031409525809167]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Price Band: &quot; + IFNULL(ATTR([Calculation_1031409524092939]), &quot;N/A&quot;)&#13;&#10;+ CHAR(10) + CHAR(10) +&#13;&#10;&quot;Price: &quot; + IFNULL(ATTR([price]), &quot;N/A&quot;)' />
      </column>
      <column caption='Open Link Text' datatype='string' name='[Calculation_1031409530626064]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Open Rightmove listing&quot;' />
      </column>
      <column caption='Sector Clean' datatype='string' name='[Calculation_2591890493792258]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE([sector], &quot; for sale&quot;, &quot;&quot;)' />
      </column>
      <column caption='Price Numeric' datatype='integer' name='[Calculation_2591890495082499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [price] = &quot;POA&quot; THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    INT(REPLACE(REPLACE([price], &quot;£&quot;, &quot;&quot;), &quot;,&quot;, &quot;&quot;))&#13;&#10;END' />
      </column>
      <column caption='Area' datatype='string' name='[Calculation_2591890495229956]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;    REGEXP_EXTRACT([location], &apos;([A-Z]{1,2}[0-9]{1,2}[A-Z]?)&apos;),&#13;&#10;    &quot;Unknown&quot;&#13;&#10;)' />
      </column>
      <column caption='Location Short' datatype='string' name='[Calculation_2591890495303685]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LEN([location]) &gt; 35 THEN&#13;&#10;    LEFT([location], 35) + &quot;...&quot;&#13;&#10;ELSE&#13;&#10;    [location]&#13;&#10;END' />
      </column>
      <column caption='Detail Text' datatype='string' name='[Calculation_2591890495373318]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Location: &quot; + IFNULL(ATTR([location]), &quot;N/A&quot;)&#13;&#10;+ CHAR(10) + CHAR(10) +&#13;&#10;&quot;Price: &quot; + IFNULL(ATTR([price]), &quot;N/A&quot;)&#13;&#10;+ CHAR(10) +&#13;&#10;&quot;Size: &quot; + IFNULL(ATTR([size]), &quot;N/A&quot;)&#13;&#10;+ CHAR(10) +&#13;&#10;&quot;Sector: &quot; + IFNULL(ATTR([Calculation_2591890493792258]), &quot;N/A&quot;)&#13;&#10;+ CHAR(10) +&#13;&#10;&quot;Gap Station: &quot; +&#13;&#10;IF ISNULL(MIN([gap_station (miles from bank station)])) THEN&#13;&#10;    &quot;N/A&quot;&#13;&#10;ELSE&#13;&#10;    STR(ROUND(MIN([gap_station (miles from bank station)]), 2)) + &quot; miles&quot;&#13;&#10;END&#13;&#10;+ CHAR(10) +&#13;&#10;&quot;Nearest Stations: &quot; + IFNULL(ATTR([nearest_stations_detail]), &quot;N/A&quot;)&#13;&#10;+ CHAR(10) +&#13;&#10;&quot;Phone: &quot; + IFNULL(ATTR([phone_number]), &quot;N/A&quot;)&#13;&#10;+ CHAR(10) +&#13;&#10;&quot;Contact: &quot; + IFNULL(ATTR([contact_info]), &quot;N/A&quot;)&#13;&#10;+ CHAR(10) + CHAR(10) +&#13;&#10;&quot;Key Features: &quot; + IFNULL(ATTR([key_features]), &quot;N/A&quot;)&#13;&#10;+ CHAR(10) + CHAR(10) +&#13;&#10;&quot;Full Description: &quot; + IFNULL(ATTR([full_description]), &quot;N/A&quot;)&#13;&#10;+ CHAR(10) + CHAR(10) +&#13;&#10;&quot;Link: &quot; + IFNULL(ATTR([links]), &quot;N/A&quot;)' />
      </column>
      <column caption='One' datatype='integer' name='[Calculation_2591890495496199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
